{
  "openapi": "3.1.0",
  "info": {
    "title": "HanziAPI",
    "description": "CRUD for hanzi characters",
    "version": "0.0.1"
  },
  "paths": {
    "/hanzi-api/hanzi": {
      "post": {
        "tags": [
          "Hanzi"
        ],
        "summary": "Create",
        "operationId": "create_hanzi_api_hanzi_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHanziDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Hanzi created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hanzi"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hanzi-api/hanzi/{character}/enrich": {
      "put": {
        "tags": [
          "Hanzi"
        ],
        "summary": "Enrich",
        "description": "Manually trigger LLM enrichment for an existing hanzi character.",
        "operationId": "enrich_hanzi_api_hanzi__character__enrich_put",
        "parameters": [
          {
            "name": "character",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Character"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Enrichment task started",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Hanzi not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hanzi-api/hanzi/{character}": {
      "get": {
        "tags": [
          "Hanzi"
        ],
        "summary": "Get",
        "operationId": "get_hanzi_api_hanzi__character__get",
        "parameters": [
          {
            "name": "character",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Character"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hanzi found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hanzi"
                }
              }
            }
          },
          "404": {
            "description": "Hanzi not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/word-api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint to verify if the API is running.",
        "operationId": "health_check_word_api_health_get",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/word-api/": {
      "post": {
        "summary": "Create",
        "operationId": "create_word_api__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWordDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Word created",
