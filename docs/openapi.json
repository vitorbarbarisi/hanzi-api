                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/word-api/search": {
      "get": {
        "summary": "Search",
        "operationId": "search_word_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Words found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Word"
                  },
                  "title": "Response Search Word Api Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/word-api/{word}": {
      "get": {
        "summary": "Get",
        "operationId": "get_word_api__word__get",
        "parameters": [
          {
            "name": "word",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Word"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Word found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordWithTranslations"
                }
              }
            }
          },
          "404": {
            "description": "Word not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/word-api/{word}/translations": {
      "put": {
        "summary": "Add Translation",
        "operationId": "add_translation_word_api__word__translations_put",
        "parameters": [
          {
            "name": "word",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Word"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWordTranslationRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Translation added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordTranslation"
                }
              }
            }
          },
          "404": {
            "description": "Word not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get Translations",
        "operationId": "get_translations_word_api__word__translations_get",
        "parameters": [
          {
            "name": "word",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Word"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Translations found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WordTranslation"
                  },
                  "title": "Response Get Translations Word Api  Word  Translations Get"
                }
              }
            }
          },
          "404": {
            "description": "Word not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
